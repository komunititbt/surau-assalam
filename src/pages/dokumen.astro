---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDocuments } from "../lib/sheets";

const docs = await getDocuments();
---
<BaseLayout title="Dokumen">
  <h1>Dokumen</h1>
  {docs.length === 0 ? (
    <div class="empty-state">Tiada dokumen tersedia.</div>
  ) : (
    <div class="card-list">
      {docs.map(d => (
        <div class="document-item">
          <div class="doc-info">
            <h3>{d.title}</h3>
            <p>{d.category}{d.published_date ? ` · 📅 ${d.published_date}` : ""}</p>
            {d.description && <p>{d.description}</p>}
          </div>
          {d.file_url
            ? <a href={d.file_url} target="_blank" rel="noopener" class="btn">Muat Turun</a>
            : <span style="color:var(--muted)">Tiada fail</span>}
        </div>
      ))}
    </div>
  )}
</BaseLayout>