---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageBySlug } from "../lib/sheets";

const page = await getPageBySlug("mengenai-kami");
---
<BaseLayout title={page?.title ?? "Mengenai Kami"}>
  {page ? (
    <>
      <h1>{page.title}</h1>
      <div class="page-content" set:html={page.content} />
    </>
  ) : (
    <>
      <h1>Mengenai Kami</h1>
      <div class="empty-state">Kandungan belum disediakan. Sila isi sheet <code>Pages</code>.</div>
    </>
  )}
</BaseLayout>